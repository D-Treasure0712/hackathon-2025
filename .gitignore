# =========================
# 全体共通 (OS, エディタ, 環境変数)
# =========================
# Mac / Windowsのシステムファイル
.DS_Store
Thumbs.db

# VS Code などのエディタ設定
.vscode/
.idea/
*.swp

# 環境変数 (秘密情報が含まれるため絶対に除外！)
.env
.env*.local


# =========================
# フロントエンド (frontend/)
# =========================
# 依存ライブラリ (重いので除外)
frontend/node_modules/

# Next.jsのビルド生成物
frontend/.next/
frontend/out/
frontend/build/

# エラーログなど
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.vercel


# =========================
# バックエンド (backend/)
# =========================
# Goのビルド済みバイナリ (実行ファイル)
backend/main
backend/main.exe

# ベンダーディレクトリ (必要な場合のみ)
backend/vendor/